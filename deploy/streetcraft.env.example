# StreetCraft Environment Configuration
# Copy this file to .env and fill in the values

# Port for the StreetCraft web server (default: 8102)
STREETCRAFT_PORT=8102

# Password hash for container authentication (Argon2id format)
# Generate with: node -e "const a=require('@node-rs/argon2');a.hash('your-password').then(h=>console.log(h))"
STREETCRAFT_PASSWORD_HASH=

# BlueMap origin URL (default: http://127.0.0.1:8101)
STREETCRAFT_BLUEMAP_ORIGIN=http://127.0.0.1:8101

# Fabric API origin (loopback only, default: http://127.0.0.1:8103)
STREETCRAFT_FABRIC_API_ORIGIN=http://127.0.0.1:8103

# Session duration in milliseconds (default: 900000 = 15 minutes)
STREETCRAFT_SESSION_DURATION_MS=900000

# Rate limiting: max failed login attempts per window
STREETCRAFT_RATE_LIMIT_MAX_FAILURES=5

# Rate limiting: window duration in milliseconds (default: 300000 = 5 minutes)
STREETCRAFT_RATE_LIMIT_WINDOW_MS=300000
