[Unit]
Description=StreetCraft web application (CoreCraft Fabric server)
After=network-online.target ccpaper.service
Wants=network-online.target

[Service]
Type=simple
User=pangrusak
WorkingDirectory=/home/pangrusak/CoreCraft_SERVER/streetcraft
Environment=NODE_ENV=production
Environment=STREETCRAFT_PORT=8104
EnvironmentFile=/home/pangrusak/CoreCraft_SERVER/streetcraft/.env
ExecStartPre=/home/pangrusak/.nvm/versions/node/v24.16.0/bin/npm run build
ExecStart=/home/pangrusak/.nvm/versions/node/v24.16.0/bin/node --import tsx server/src/index.ts
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/pangrusak/CoreCraft_SERVER/streetcraft

# Resource limits
LimitNOFILE=1024
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target